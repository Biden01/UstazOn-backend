# Postgres (used by docker-compose.yml for both the db and backend services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=ustazon

# Only needed if you run the backend outside docker-compose
DATABASE_URL=postgresql+asyncpg://postgres:change-me-to-a-strong-random-password@localhost:5432/ustazon

# JWT signing key - generate a real random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never reuse this example value or commit the real one.
SECRET_KEY=CHANGE-ME-generate-a-random-64-byte-secret

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://ustazon.com"]

# SMS (Mobizon)
SMS_ENABLED=false
MOBIZON_API_KEY=your-mobizon-api-key
MOBIZON_API_URL=https://api.mobizon.kz/service
